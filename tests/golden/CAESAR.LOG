Pseudo-Pascal to 8086 assembly compiler - Lorenzo Dal Col, 2006
1: program
2:     var k,cESC
3:     $title = "Type some text: each letter shifts by one. Esc quits."
4: begin
5:     writeStr($title)
6:     newline
7:     cESC=27
8:     read(k)
9:     while(k<>cESC)
10:         if((k>='a') & (k<='z')) | ((k>='A') & (k<='Z'))
11:             k=k+1
12:         endif
13:         write(k)
14:         read(k)
15:     endwhile
16: end.
