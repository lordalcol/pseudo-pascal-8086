Pseudo-Pascal to 8086 assembly compiler - Lorenzo Dal Col, 2006
1: program
2:     var key
3:     $title = "Press keys to see their ASCII codes. Esc quits."
4: begin
5:     writeStr($title)
6:     newline
7:     newline
8:     read(key)
9:     while key <> 27
10:         write(key,':',' ')
11:         writeInt(key)
12:         newline
13:         read(key)
14:     endwhile
15: end.
