{
  "name": "pseudo-pascal-8086",
  "version": "1.0.0",
  "description": "A pseudo-Pascal to 8086 assembly compiler written in 8086 assembly (2006), with a JavaScript port and an 8086 simulator that run it in the browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc",
    "golden": "node scripts/dos.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "emulators": "8.5.2",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0"
  }
}
